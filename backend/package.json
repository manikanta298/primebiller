{
  "name": "primebiller-backend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "npm run db:migrate && node server.js",
    "db:schema": "node scripts/apply-schema.js",
    "db:migrate": "node scripts/migrate.js",
    "seed:data": "node seed-data.js && node seed-pending-data.js",
    "setup": "npm run db:schema && npm run db:migrate && npm run seed:data",
    "test": "node --test",
    "auth:set-password": "node scripts/set-password.js",
    "data:clear": "node scripts/clear-data.js",
    "templates:build": "node scripts/build-templates.js",
    "migrate:new": "node scripts/new-migration.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
