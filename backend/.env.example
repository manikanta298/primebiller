# Better Auth
BETTER_AUTH_SECRET=replace-with-a-32-plus-character-random-secret
BETTER_AUTH_URL=http://localhost:3005
FRONTEND_URL=http://localhost:5173

# MySQL
DATABASE_URL=mysql://root:password@localhost:3306/girder

# Dummy logins (used until a real email ID is provided).
# Both accounts share DUMMY_PASSWORD. Dev only — change before any deployment.
DUMMY_PASSWORD=Girder@12345
DEMO_EMAIL=manikantakambala12@gmail.com

# Email OTP via Google SMTP.
# 1) Turn on 2-Step Verification  2) Create an App Password at myaccount.google.com/apppasswords
# Leave SMTP_HOST empty => OTP is printed to the server console instead (dev only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=16-character-app-password
SMTP_FROM="Girder <youraddress@gmail.com>"
