DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED
FRONTEND_URL=http://localhost:5173

DEMO_EMAIL=your-test-email@example.com
DUMMY_PASSWORD=use-a-private-test-password

# --- Email delivery (pick ONE) ---
# Render FREE web services block outbound SMTP (ports 25/465/587), so Gmail SMTP will time out there.
# Option A (recommended on Render): HTTPS email API over port 443. Set ONE of these keys.
# MAIL_FROM must be a sender/domain you have verified with the provider.
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM="PrimeBiller <no-reply@example.com>"

# Option B: SMTP (works locally and on paid Render instances).
# Debug only: print the OTP in server logs (ignored when NODE_ENV=production unless LOG_OTP_IN_PRODUCTION=true).
LOG_OTP=false
# LOG_OTP_IN_PRODUCTION=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PrimeBiller <no-reply@example.com>"
