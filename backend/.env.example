DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED
FRONTEND_URL=http://localhost:5173

# Single dummy account accepted by the login flow.
DEMO_EMAIL=your-test-email@example.com
DUMMY_PASSWORD=use-a-private-test-password

# --- Email delivery (pick ONE) ---
# Render FREE web services block outbound SMTP (ports 25/465/587).
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM="PrimeBiller <no-reply@example.com>"

# SMTP is disabled by default. Enable only for local/paid environments where SMTP is allowed.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PrimeBiller <no-reply@example.com>"

# TEMPORARY TESTING ONLY:
# The OTP for DEMO_EMAIL is always printed to the server/Render logs.
# LOG_OTP=true also prints OTPs for non-demo recipients.
# In production, non-demo logging additionally requires LOG_OTP_IN_PRODUCTION=true.
LOG_OTP=false
# LOG_OTP_IN_PRODUCTION=false
# OTP_CONSOLE_ONLY=false
